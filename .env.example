# Server secrets
SESSION_SECRET=change-this-to-a-long-random-secret
PORT=3000

# Existing admin panel. This is NOT required for user uploads.
ADMIN_PASSWORD=change-this-admin-password

# Optional Google Login. Leave blank until Google OAuth is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-RENDER-DOMAIN.onrender.com/auth/google/callback
BASE_URL=https://YOUR-RENDER-DOMAIN.onrender.com
